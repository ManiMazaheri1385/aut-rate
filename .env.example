# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aut_reviews?schema=public"

# Clerk (https://dashboard.clerk.com -> API Keys)
# Production instance keys start with pk_live_ / sk_live_
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=""
CLERK_SECRET_KEY=""
# Custom sign-in page route used by the protected-route redirect
NEXT_PUBLIC_CLERK_SIGN_IN_URL="/login"
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL="/dashboard"
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL="/dashboard"

# Auto-promoted administrator email (must end with @aut.ac.ir)
ADMIN_EMAIL=""

# Upstash Redis (optional; falls back to in-memory cache when not set)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/aut_reviews?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="change-me-in-production"

# SMTP for sending OTP emails (leave empty in development to print OTP to server console)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
OTP_FROM_EMAIL="no-reply@aut.ac.ir"

# Upstash Redis (optional; falls back to in-memory cache when not set)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
